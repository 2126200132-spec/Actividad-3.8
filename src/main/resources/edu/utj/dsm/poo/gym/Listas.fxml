<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>

<AnchorPane prefHeight="450.0" prefWidth="650.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" 
            fx:controller="edu.utj.dsm.poo.gym.controlador.listasController">
   <children>
      <!-- TABLA EN LA PARTE SUPERIOR -->
      <TableView fx:id="tblListas" layoutX="25.0" layoutY="25.0" prefHeight="280.0" prefWidth="600.0" AnchorPane.leftAnchor="25.0" AnchorPane.rightAnchor="25.0" AnchorPane.topAnchor="25.0">
        <columns>
          <TableColumn fx:id="colId" prefWidth="100.0" text="ID" />
          <TableColumn fx:id="colNombre" prefWidth="220.0" text="Nombre" />
          <TableColumn fx:id="colPrecio" prefWidth="130.0" text="Precio" />
          <TableColumn fx:id="colEstado" prefWidth="145.0" text="Estado" />
        </columns>
      </TableView>

      <!-- CAMPOS DE TEXTO/COMBOBOX ABAJO DE LA TABLA -->
      <HBox layoutX="25.0" layoutY="325.0" spacing="10.0" AnchorPane.leftAnchor="25.0" AnchorPane.rightAnchor="25.0">
         <children>
            <TextField fx:id="txtId" prefWidth="120.0" promptText="ID" />
            <TextField fx:id="txtNombre" prefWidth="200.0" promptText="Nombre" />
            <TextField fx:id="txtPrecio" prefWidth="120.0" promptText="Precio" />
            <ComboBox fx:id="cmbEstado" prefWidth="130.0" promptText="Estado" />
         </children>
      </HBox>

      <!-- BOTONES EN LA ESQUINA INFERIOR DERECHA (CRUD COMPLETO) -->
      <HBox layoutX="320.0" layoutY="380.0" spacing="10.0" AnchorPane.rightAnchor="25.0">
         <children>
            <Button fx:id="btnGuardar" onAction="#handleGuardar" text="Guardar" />
            <Button fx:id="btnActualizar" onAction="#handleActualizar" text="Actualizar" />
            <Button fx:id="btnEliminar" onAction="#handleEliminar" text="Eliminar" />
            <Button fx:id="btnLimpiar" onAction="#handleLimpiar" text="Limpiar" />
         </children>
      </HBox>
   </children>
</AnchorPane>