<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" prefHeight="450.0" prefWidth="650.0" spacing="15.0" xmlns="http://javafx.com/javafx/19" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.utj.dsm.poo.gym.controlador.LoginController">
   <children>
      <Label text="SISTEMA DE GESTIÓN DE GIMNASIO">
         <font>
            <Font name="System Bold" size="22.0" />
         </font>
      </Label>
      <TextField fx:id="txtUsuario" maxWidth="250.0" prefHeight="35.0" promptText="Usuario" />
      <PasswordField fx:id="txtPassword" maxWidth="250.0" prefHeight="35.0" promptText="Contraseña" />
      <Button mnemonicParsing="false" onAction="#handleEntrar" prefHeight="40.0" prefWidth="250.0" text="Entrar" />
      <Button mnemonicParsing="false" onAction="#handleCerrar" prefHeight="40.0" prefWidth="250.0" text="Cerrar aplicación" />
   </children>
</VBox>