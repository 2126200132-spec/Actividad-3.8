<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>

<AnchorPane prefHeight="450.0" prefWidth="650.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" 
            fx:controller="edu.utj.dsm.poo.gym.controlador.AdministradorController">
   <children>
      <!-- TABLA DE ADMINISTRADORES -->
      <TableView fx:id="tblAdministradores" layoutX="25.0" layoutY="25.0" prefHeight="280.0" prefWidth="600.0" AnchorPane.leftAnchor="25.0" AnchorPane.rightAnchor="25.0" AnchorPane.topAnchor="25.0">
        <columns>
          <TableColumn fx:id="colId" prefWidth="80.0" text="ID" />
          <TableColumn fx:id="colNombre" prefWidth="180.0" text="Nombre Admin" />
          <TableColumn fx:id="colEmail" prefWidth="190.0" text="Correo Electrónico" />
          <TableColumn fx:id="colRol" prefWidth="150.0" text="Rol / Permiso" />
        </columns>
      </TableView>

      <!-- CAMPOS DE TEXTO Y COMBOBOX -->
      <HBox layoutX="25.0" layoutY="325.0" spacing="10.0" AnchorPane.leftAnchor="25.0" AnchorPane.rightAnchor="25.0">
         <children>
            <TextField fx:id="txtId" prefWidth="80.0" promptText="ID" />
            <TextField fx:id="txtNombre" prefWidth="180.0" promptText="Nombre Admin" />
            <TextField fx:id="txtEmail" prefWidth="190.0" promptText="Correo Electrónico" />
            <ComboBox fx:id="cmbRol" prefWidth="140.0" promptText="Rol" />
         </children>
      </HBox>

      <!-- MENSAJES DE ERROR EN TIEMPO REAL -->
      <HBox layoutX="25.0" layoutY="352.0" spacing="10.0" AnchorPane.leftAnchor="25.0" AnchorPane.rightAnchor="25.0">
         <children>
            <Label fx:id="lblErrorId" prefWidth="80.0" text="" textFill="RED" style="-fx-font-size: 9px;" wrapText="true" />
            <Label fx:id="lblErrorNombre" prefWidth="180.0" text="" textFill="RED" style="-fx-font-size: 9px;" wrapText="true" />
            <Label fx:id="lblErrorEmail" prefWidth="190.0" text="" textFill="RED" style="-fx-font-size: 9px;" wrapText="true" />
            <Label fx:id="lblErrorRol" prefWidth="140.0" text="" textFill="RED" style="-fx-font-size: 9px;" wrapText="true" />
         </children>
      </HBox>

      <!-- BOTONES EN ESQUINA INFERIOR DERECHA -->
      <HBox layoutX="180.0" layoutY="390.0" spacing="8.0" AnchorPane.rightAnchor="25.0">
         <children>
            <Button fx:id="btnNuevo" text="Nuevo" onAction="#handleNuevo" />
            <Button fx:id="btnValidar" text="Validar" onAction="#handleValidar" />
            <Button fx:id="btnGuardar" text="Guardar" onAction="#handleGuardar" />
            <Button fx:id="btnEditar" text="Editar" onAction="#handleEditar" />
            <Button fx:id="btnEliminar" text="Eliminar" onAction="#handleEliminar" />
            <Button fx:id="btnLimpiar" text="Limpiar" onAction="#handleLimpiar" />
         </children>
      </HBox>
   </children>
</AnchorPane>