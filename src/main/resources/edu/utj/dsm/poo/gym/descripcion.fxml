<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.utj.dsm.poo.gym.controlador.DescripcionController">
   <children>
      <TableView fx:id="tableView" layoutX="14.0" layoutY="14.0" prefHeight="250.0" prefWidth="570.0">
        <columns>
          <TableColumn fx:id="colNombre" prefWidth="130.0" text="Nombre" />
          <TableColumn fx:id="colPrecio" prefWidth="100.0" text="Precio" />
            <TableColumn fx:id="colCantidad" prefWidth="100.0" text="Cantidad" />
            <TableColumn fx:id="colDescripcion" prefWidth="238.0" text="Descripcion" />
        </columns>
      </TableView>
      
      <TextField fx:id="txtNombre" layoutX="14.0" layoutY="280.0" prefWidth="120.0" promptText="Nombre" />
      <TextField fx:id="txtPrecio" layoutX="140.0" layoutY="280.0" prefWidth="90.0" promptText="Precio" />
      <TextField fx:id="txtCantidad" layoutX="236.0" layoutY="280.0" prefWidth="90.0" promptText="Cantidad" />
      <TextField fx:id="txtDescripcion" layoutX="332.0" layoutY="280.0" prefWidth="252.0" promptText="Descripción" />
      
      <Button fx:id="btnAdd" layoutX="350.0" layoutY="325.0" onAction="#handleBtnAdd" text="Agregar" />
      <Button fx:id="btnDel" layoutX="425.0" layoutY="325.0" onAction="#handleBtnDel" text="Borrar" />
      <Button fx:id="btnReset" layoutX="490.0" layoutY="325.0" onAction="#handleBtnReset" text="Reiniciar" />
   </children>
</AnchorPane>